# Nova AI Backend Server Configuration

# Express Server Port
PORT=3001

# AI Image Generation API Configuration
# Options for IMAGE_API_PROVIDER: 'pollinations', 'huggingface', 'together', 'openai'
IMAGE_API_PROVIDER=pollinations

# API Key for paid/restricted providers (Keep key secret; NEVER commit to git or expose to frontend)
IMAGE_API_KEY=your_api_key_here

# Groq API key for Vite frontend usage
VITE_GROQ_DEFAULT_API_KEY=your_groq_key_here

# AI Image Model (e.g. 'flux', 'black-forest-labs/FLUX.1-schnell', 'dall-e-3')
IMAGE_API_MODEL=flux
