{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.novaai.desktop",
  "productName": "Nova AI",
  "copyright": "Copyright © 2026 Nova AI",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/.cache/**/*",
    "!node_modules/**/{CHANGELOG.md,README.md,readme.md,*.ts,*.map}",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/.bin/**"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/electron-updater/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Nova AI"
  },
  "publish": null
}
